{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Nathenael Tamirat's production-ready Next.js portfolio.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NathenaelTamirat/portfolio.git"
  },
  "keywords": [
    "portfolio",
    "nextjs",
    "typescript"
  ],
  "author": "Nathenael Tamirat",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NathenaelTamirat/portfolio/issues"
  },
  "homepage": "https://github.com/NathenaelTamirat/portfolio#readme",
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
